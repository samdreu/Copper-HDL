# Verilator build artifacts (per-invocation work dirs live under target/verilator/)
obj_dir/
obj_dir_*/
tb_*.cpp
# Generated Verilog (hand-written references are tracked as .sv under
# tests/fixtures/reference_sv/ and examples/*/sv/)
*.v

# Rust build artifacts
target/
**/*.rs.bk

# Generated files
*.d

# macOS system files
.DS_Store

# Generated simulation waveforms
waveforms/

# Local agent/editor config
.claude/
smoke-failure.log
regression-failure.log
# The paper itself (drafts, templates, third-party PDFs, build logs) stays out of
# the repository. `paper/stats/` is the exception: it is the generated evaluation
# record (`tools/stats/collect.sh`) that the README and the stats scripts point at.
paper/*
!paper/stats/
paper/stats-quick/
.claude/worktrees/
